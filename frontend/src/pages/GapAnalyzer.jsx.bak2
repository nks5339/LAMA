import React, { useState, useEffect, useRef, useCallback } from "react";
import { 
  Upload, Play, RefreshCw, Search, CheckCircle, AlertTriangle, 
  Info, X, AlertCircle, Download, FileSpreadsheet, FileJson, 
  FileText, File, Archive, FileCode, Trash2, ChevronDown, ChevronRight,
  Code, BookOpen, Layers, GitCompare, Filter, ArrowUpDown, Eye, 
  Zap, Target, BarChart3, FileCheck, Box, Database, Route, Shield
} from "lucide-react";
import {
  createGapAnalysis,
  pollGapAnalysisStatus,
  getGapAnalysis,
  gapAnalysisExportUrl,
} from "../lib/api";

/* ─────────────── Constants & Utilities ─────────────── */

const FILE_TYPES = {
  code: { label: "Source Code", icon: FileCode, color: "purple", extensions: [".zip", ".tar", ".gz", ".java", ".py", ".js", ".ts", ".php", ".cs", ".go", ".rb"] },
  srs: { label: "SRS Document", icon: FileText, color: "blue", extensions: [".md", ".pdf", ".docx", ".doc", ".txt"] },
  frs: { label: "FRS Document", icon: FileText, color: "indigo", extensions: [".md", ".pdf", ".docx", ".doc", ".txt"] },
  api: { label: "API Specification", icon: FileText, color: "green", extensions: [".yaml", ".yml", ".json", ".openapi"] },
};

const PHASES = [
  { id: "upload", label: "Upload", icon: Upload },
  { id: "kb", label: "Build KB", icon: Database },
  { id: "extract", label: "Extract", icon: Layers },
  { id: "verify", label: "Cross-Verify", icon: GitCompare },
  { id: "report", label: "Report", icon: BarChart3 },
];

const detectFileType = (filename) => {
  const ext = filename.toLowerCase().slice(filename.lastIndexOf("."));
  if ([".zip", ".tar", ".gz", ".tgz"].includes(ext)) return "code";
  if ([".java", ".py", ".js", ".ts", ".jsx", ".tsx", ".php", ".cs", ".go", ".rb", ".c", ".cpp", ".h"].includes(ext)) return "code";
  const lowerName = filename.toLowerCase();
  if (lowerName.includes("srs") || lowerName.includes("requirement") || lowerName.includes("spec")) return "srs";
  if (lowerName.includes("frs") || lowerName.includes("functional")) return "frs";
  if (lowerName.includes("api") || lowerName.includes("swagger") || lowerName.includes("openapi")) return "api";
  if ([".md", ".pdf", ".docx", ".doc", ".txt"].includes(ext)) return "srs";
  return "code";
};

const getFileTypeColor = (type) => ({
  code: "bg-purple-100 text-purple-700 border-purple-200",
  srs: "bg-blue-100 text-blue-700 border-blue-200",
  frs: "bg-indigo-100 text-indigo-700 border-indigo-200",
  api: "bg-green-100 text-green-700 border-green-200",
}[type] || "bg-gray-100 text-gray-700 border-gray-200");

const formatSize = (bytes) => {
  if (bytes < 1024) return bytes + " B";
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
  return (bytes / (1024 * 1024)).toFixed(1) + " MB";
};

/* ─────────────── Phase Progress Indicator ─────────────── */

const PhaseProgress = ({ currentPhase, completedPhases }) => (
  <div className="flex items-center justify-between px-4 py-3 bg-slate-50 border-b border-slate-200">
    {PHASES.map((phase, idx) => {
      const isCompleted = completedPhases.includes(phase.id);
      const isCurrent = currentPhase === phase.id;
      const Icon = phase.icon;
      return (
        <React.Fragment key={phase.id}>
          <div className={`flex items-center gap-2 ${isCurrent ? "text-yellow-600" : isCompleted ? "text-green-600" : "text-slate-400"}`}>
            <div className={`w-8 h-8 rounded-full flex items-center justify-center ${
              isCurrent ? "bg-yellow-100 ring-2 ring-yellow-400" : 
              isCompleted ? "bg-green-100" : "bg-slate-100"
            }`}>
              {isCompleted ? <CheckCircle size={16} /> : isCurrent ? <RefreshCw size={16} className="animate-spin" /> : <Icon size={16} />}
            </div>
            <span className={`text-xs font-medium hidden sm:block ${isCurrent ? "text-yellow-700" : ""}`}>{phase.label}</span>
          </div>
          {idx < PHASES.length - 1 && (
            <div className={`flex-1 h-0.5 mx-2 ${isCompleted ? "bg-green-300" : "bg-slate-200"}`} />
          )}
        </React.Fragment>
      );
    })}
  </div>
);

/* ─────────────── File Item Component ─────────────── */

const FileItem = ({ file, onRemove, onTypeChange, compact = false }) => {
  const [showDropdown, setShowDropdown] = useState(false);
  const Icon = file.type === "code" ? Archive : FileText;
  
  if (compact) {
    return (
      <div className="flex items-center gap-2 px-2 py-1.5 bg-white border border-slate-200 rounded text-xs group">
        <Icon size={14} className={file.type === "code" ? "text-purple-500" : "text-blue-500"} />
        <span className="flex-1 truncate text-slate-700">{file.file.name}</span>
        <span className="text-slate-400">{formatSize(file.file.size)}</span>
        <button onClick={onRemove} className="p-0.5 text-slate-400 hover:text-red-500 opacity-0 group-hover:opacity-100">
          <X size={12} />
        </button>
      </div>
    );
  }
  
  return (
    <div className="flex items-center gap-3 px-3 py-2 bg-white border border-slate-200 rounded-lg group hover:border-slate-300 transition-colors">
      <Icon size={18} className={file.type === "code" ? "text-purple-500" : "text-blue-500"} />
      <div className="flex-1 min-w-0">
        <p className="text-sm font-medium text-slate-800 truncate">{file.file.name}</p>
        <p className="text-xs text-slate-400">{formatSize(file.file.size)}</p>
      </div>
      <div className="relative">
        <button
          onClick={() => setShowDropdown(!showDropdown)}
          className={`px-2 py-1 text-xs font-medium rounded border ${getFileTypeColor(file.type)} flex items-center gap-1`}
        >
          {FILE_TYPES[file.type]?.label.split(" ")[0] || "Code"}
          <ChevronDown size={12} />
        </button>
        {showDropdown && (
          <div className="absolute right-0 top-full mt-1 bg-white border border-slate-200 rounded-lg shadow-lg z-10 min-w-[160px]">
            {Object.entries(FILE_TYPES).map(([key, val]) => (
              <button
                key={key}
                onClick={() => { onTypeChange(key); setShowDropdown(false); }}
                className={`w-full px-3 py-2 text-left text-sm hover:bg-slate-50 flex items-center gap-2 ${file.type === key ? "bg-slate-50" : ""}`}
              >
                <val.icon size={14} />
                {val.label}
                {file.type === key && <CheckCircle size={14} className="ml-auto text-green-500" />}
              </button>
            ))}
          </div>
        )}
      </div>
      <button onClick={onRemove} className="p-1 text-slate-400 hover:text-red-500 opacity-0 group-hover:opacity-100 transition-opacity">
        <X size={16} />
      </button>
    </div>
  );
};

/* ─────────────── Entity Preview Card ─────────────── */

const EntityCard = ({ title, icon: Icon, count, items, color = "slate", expanded = false, onToggle }) => {
  const [isExpanded, setIsExpanded] = useState(expanded);
  const colors = {
    purple: "bg-purple-50 border-purple-200 text-purple-700",
    blue: "bg-blue-50 border-blue-200 text-blue-700",
    green: "bg-green-50 border-green-200 text-green-700",
    orange: "bg-orange-50 border-orange-200 text-orange-700",
    slate: "bg-slate-50 border-slate-200 text-slate-700",
  };
  
  return (
    <div className={`rounded-lg border ${colors[color]}`}>
      <button 
        onClick={() => setIsExpanded(!isExpanded)}
        className="w-full flex items-center justify-between px-3 py-2"
      >
        <div className="flex items-center gap-2">
          <Icon size={14} />
          <span className="text-xs font-medium">{title}</span>
          <span className="text-xs opacity-70">({count})</span>
        </div>
        <ChevronRight size={14} className={`transform transition-transform ${isExpanded ? "rotate-90" : ""}`} />
      </button>
      {isExpanded && items?.length > 0 && (
        <div className="px-3 pb-2 max-h-32 overflow-y-auto">
          <div className="space-y-1">
            {items.slice(0, 20).map((item, i) => (
              <div key={i} className="text-xs px-2 py-1 bg-white/60 rounded truncate">{item}</div>
            ))}
            {items.length > 20 && <div className="text-xs text-center opacity-60">+{items.length - 20} more</div>}
          </div>
        </div>
      )}
    </div>
  );
};

/* ─────────────── Gap Card Component ─────────────── */

const GapCard = ({ gap, index }) => {
  const [expanded, setExpanded] = useState(false);
  const severityColors = {
    critical: { bg: "bg-red-50", border: "border-red-200", dot: "bg-red-500", badge: "bg-red-100 text-red-700" },
    major: { bg: "bg-orange-50", border: "border-orange-200", dot: "bg-orange-400", badge: "bg-orange-100 text-orange-700" },
    minor: { bg: "bg-yellow-50", border: "border-yellow-200", dot: "bg-yellow-400", badge: "bg-yellow-100 text-yellow-700" },
  };
  const colors = severityColors[gap.severity] || severityColors.minor;
  
  return (
    <div className={`rounded-lg border ${colors.border} ${colors.bg} overflow-hidden`}>
      <button onClick={() => setExpanded(!expanded)} className="w-full flex items-start gap-3 p-3 text-left">
        <span className={`mt-1.5 w-2 h-2 rounded-full flex-shrink-0 ${colors.dot}`} />
        <div className="flex-1 min-w-0">
          <div className="flex items-center gap-2 flex-wrap">
            <span className="font-medium text-slate-800 text-sm">{gap.title || `Gap #${index + 1}`}</span>
            <span className={`text-[10px] px-1.5 py-0.5 rounded font-medium uppercase ${colors.badge}`}>
              {gap.severity}
            </span>
            {gap.category && <span className="text-[10px] px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">{gap.category}</span>}
          </div>
          <p className="text-sm text-slate-600 mt-1 line-clamp-2">{gap.description}</p>
        </div>
        <ChevronRight size={16} className={`text-slate-400 transform transition-transform flex-shrink-0 ${expanded ? "rotate-90" : ""}`} />
      </button>
      {expanded && (
        <div className="px-3 pb-3 space-y-2 border-t border-slate-100 pt-2 ml-5">
          {gap.location && (
            <div className="flex items-center gap-2 text-xs text-slate-500">
              <FileCode size={12} />
              <span>{gap.location}</span>
            </div>
          )}
          {gap.requirement_id && (
            <div className="flex items-center gap-2 text-xs text-blue-600">
              <Target size={12} />
              <span>Requirement: {gap.requirement_id}</span>
            </div>
          )}
          {gap.recommendation && (
            <div className="text-xs p-2 bg-green-50 border border-green-100 rounded text-green-700">
              <span className="font-medium">💡 Recommendation:</span> {gap.recommendation}
            </div>
          )}
        </div>
      )}
    </div>
  );
};

/* ─────────────── Coverage Matrix Row ─────────────── */

const CoverageRow = ({ item, index }) => {
  const statusColors = {
    covered: { bg: "bg-green-100", text: "text-green-700", icon: CheckCircle },
    partial: { bg: "bg-yellow-100", text: "text-yellow-700", icon: AlertTriangle },
    missing: { bg: "bg-red-100", text: "text-red-700", icon: AlertCircle },
  };
  const colors = statusColors[item.status] || statusColors.missing;
  const Icon = colors.icon;
  
  return (
    <tr className={index % 2 === 0 ? "bg-white" : "bg-slate-50"}>
      <td className="px-3 py-2 text-xs font-mono text-slate-600">{item.requirement_id || item.requirement?.slice(0, 20) || `REQ-${index + 1}`}</td>
      <td className="px-3 py-2 text-xs text-slate-700 max-w-xs truncate">{item.requirement || item.description || "—"}</td>
      <td className="px-3 py-2">
        <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-medium ${colors.bg} ${colors.text}`}>
          <Icon size={10} />
          {item.status}
        </span>
      </td>
      <td className="px-3 py-2 text-xs text-slate-500 font-mono">{item.code_refs?.join(", ") || "—"}</td>
    </tr>
  );
};

/* ─────────────── Main Component ─────────────── */

export default function GapAnalyzerPage() {
  const [name, setName] = useState("");
  const [files, setFiles] = useState([]);
  const [isDragging, setIsDragging] = useState(false);
  
  const [creating, setCreating] = useState(false);
  const [result, setResult] = useState(null);
  const [entities, setEntities] = useState(null);
  const [requirements, setRequirements] = useState(null);
  const [status, setStatus] = useState(null);
  const [error, setError] = useState(null);
  const [analysisId, setAnalysisId] = useState(null);
  const [currentPhase, setCurrentPhase] = useState(null);
  const [completedPhases, setCompletedPhases] = useState([]);
  const [progress, setProgress] = useState({ phase: null, percent: 0, message: "" });
  
  // Filter/sort state for results
  const [severityFilter, setSeverityFilter] = useState("all");
  const [sortBy, setSortBy] = useState("severity");
  const [activeTab, setActiveTab] = useState("gaps");
  
  const pollRef = useRef(null);
  const dropRef = useRef(null);

  // Polling for analysis status
  useEffect(() => {
    if (!analysisId || status === "completed" || status === "failed") return;
    
    const poll = async () => {
      try {
        const statusRes = await pollGapAnalysisStatus(analysisId);
        
        // Update phases based on status progress
        if (statusRes.phase) {
          // Map backend phase names → FE PHASES ids
          const phaseMap = {
            "building_kb": "kb",
            "extracting": "extract",
            "analyzing": "verify",
            "completed": "report",
            "failed": null,
          };
          const mapped = phaseMap[statusRes.phase] || statusRes.phase;
          setCurrentPhase(mapped);
          const phaseOrder = ["upload", "kb", "extract", "verify", "report"];
          const currentIdx = phaseOrder.indexOf(mapped);
          if (currentIdx > 0) {
            setCompletedPhases(phaseOrder.slice(0, currentIdx));
          }
        }
        
        // Update entities/requirements if available
        if (statusRes.entities) setEntities(statusRes.entities);
        if (statusRes.requirements) setRequirements(statusRes.requirements);
        
        if (statusRes.status === "completed") {
          const full = await getGapAnalysis(analysisId);
          setResult(full?.result || {});
          if (full?.entities) setEntities(full.entities);
          if (full?.requirements) setRequirements(full.requirements);
          setStatus("completed");
          setCurrentPhase("report");
          setCompletedPhases(["upload", "kb", "extract", "verify", "report"]);
          setProgress({ phase: "done", percent: 100, message: "Analysis complete!" });
        } else if (statusRes.status === "failed") {
          setStatus("failed");
          setError(statusRes.error || "Analysis failed");
        } else {
          pollRef.current = setTimeout(poll, 2000);
        }
      } catch (e) {
        pollRef.current = setTimeout(poll, 3000);
      }
    };
    
    pollRef.current = setTimeout(poll, 2000);
    return () => clearTimeout(pollRef.current);
  }, [analysisId, status]);

  // Handle file additions
  const addFiles = useCallback((newFiles) => {
    const processed = Array.from(newFiles).map(file => ({
      file,
      type: detectFileType(file.name),
    }));
    setFiles(prev => [...prev, ...processed]);
  }, []);

  // Drag & Drop handlers
  const handleDragOver = (e) => { e.preventDefault(); setIsDragging(true); };
  const handleDragLeave = (e) => { e.preventDefault(); setIsDragging(false); };
  const handleDrop = (e) => {
    e.preventDefault();
    setIsDragging(false);
    addFiles(e.dataTransfer.files);
  };

  // Submit
  const handleCreate = async () => {
    if (!name.trim()) return alert("Please enter an analysis name");
    
    const codeFiles = files.filter(f => f.type === "code").map(f => f.file);
    const docFiles = files.filter(f => f.type !== "code").map(f => f.file);
    
    if (codeFiles.length === 0) return alert("Please add at least one code file (ZIP/TAR)");
    if (docFiles.length === 0) return alert("Please add at least one documentation file (SRS/FRS)");
    
    setCreating(true);
    setStatus("analyzing");
    setResult(null);
    setEntities(null);
    setRequirements(null);
    setError(null);
    setAnalysisId(null);
    setCurrentPhase("upload");
    setCompletedPhases([]);
    setProgress({ phase: "uploading", percent: 0, message: "Uploading files..." });
    
    try {
      const fd = new FormData();
      fd.append("name", name);
      codeFiles.forEach(f => fd.append("code_zip", f));
      docFiles.forEach(f => fd.append("docs_zip", f));
      
      const created = await createGapAnalysis(fd, {
        onProgress: (p) => setProgress(p),
      });
      
      if (created?._id) {
        setAnalysisId(created._id);
        setCompletedPhases(["upload"]);
        setCurrentPhase("kb");
        setProgress({ phase: "analyzing", percent: 20, message: "Building knowledge base..." });
      }
    } catch (e) {
      setError(e.message);
      setStatus("failed");
    } finally {
      setCreating(false);
    }
  };

  const reset = () => {
    clearTimeout(pollRef.current);
    setName("");
    setFiles([]);
    setResult(null);
    setEntities(null);
    setRequirements(null);
    setStatus(null);
    setError(null);
    setAnalysisId(null);
    setCurrentPhase(null);
    setCompletedPhases([]);
    setProgress({ phase: null, percent: 0, message: "" });
    setSeverityFilter("all");
    setActiveTab("gaps");
  };

  const codeCount = files.filter(f => f.type === "code").length;
  const docCount = files.filter(f => f.type !== "code").length;
  const totalSize = files.reduce((sum, f) => sum + f.file.size, 0);
  
  // Filter and sort gaps
  const filteredGaps = (result?.gaps || []).filter(g => 
    severityFilter === "all" || g.severity === severityFilter
  ).sort((a, b) => {
    if (sortBy === "severity") {
      const order = { critical: 0, major: 1, minor: 2 };
      return (order[a.severity] || 3) - (order[b.severity] || 3);
    }
    return 0;
  });

  return (
    <div className="flex-1 flex flex-col min-h-0 bg-[#FAFAFA]">
      {/* Compact Header */}
      <div className="h-14 px-6 flex items-center justify-between bg-white border-b border-gray-200">
        <div className="flex items-center gap-3">
          <div className="w-9 h-9 rounded-lg bg-gradient-to-br from-[#FFE600] to-[#FFD000] flex items-center justify-center shadow-sm">
            <Search size={18} className="text-[#2E2E38]" />
          </div>
          <div>
            <h1 className="text-base font-semibold text-[#2E2E38]">Gap Analyzer</h1>
            <p className="text-xs text-gray-500">Compare code against documentation</p>
          </div>
        </div>
        
        {status && (
          <div className={`px-3 py-1.5 rounded-full text-xs font-medium flex items-center gap-1.5 ${
            status === "completed" ? "bg-green-100 text-green-700" :
            status === "failed" ? "bg-red-100 text-red-700" :
            "bg-blue-100 text-blue-700"
          }`}>
            {status === "completed" ? <CheckCircle size={14} /> :
             status === "failed" ? <AlertTriangle size={14} /> :
             <RefreshCw size={14} className="animate-spin" />}
            {status.charAt(0).toUpperCase() + status.slice(1)}
          </div>
        )}
      </div>

      {/* Main Content */}
      <div className="flex-1 overflow-y-auto p-5">
        <div className="max-w-5xl mx-auto">
          
          {/* Input Section - Show when not running */}
          {status !== "analyzing" && status !== "completed" && (
            <div className="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
              {/* Top Bar */}
              <div className="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
                <div className="flex-1 max-w-md">
                  <input
                    type="text"
                    value={name}
                    onChange={(e) => setName(e.target.value)}
                    placeholder="Analysis name (e.g., NEHS Gap Review)"
                    className="w-full px-0 py-1 text-base font-medium border-0 border-b-2 border-transparent focus:border-[#FFE600] focus:ring-0 bg-transparent placeholder-gray-400"
                  />
                </div>
                
                {/* File Type Badge */}
                <div className="flex items-center gap-2">
                  <span className="text-xs px-2 py-1 rounded bg-gray-100 text-gray-600">Auto-detect</span>
                </div>
              </div>
              
              {/* Drop Zone */}
              <div
                ref={dropRef}
                onDragOver={handleDragOver}
                onDragLeave={handleDragLeave}
                onDrop={handleDrop}
                className={`p-6 transition-colors ${isDragging ? "bg-[#FFFCE6]" : "bg-gray-50"}`}
              >
                <input
                  type="file"
                  multiple
                  onChange={(e) => addFiles(e.target.files)}
                  className="hidden"
                  id="file-upload"
                  accept=".zip,.tar,.gz,.java,.py,.js,.ts,.php,.md,.pdf,.docx,.doc,.txt,.yaml,.yml,.json"
                />
                <label 
                  htmlFor="file-upload" 
                  className={`flex flex-col items-center justify-center py-8 border-2 border-dashed rounded-xl cursor-pointer transition-colors ${
                    isDragging ? "border-[#FFE600] bg-white" : "border-gray-300 hover:border-gray-400"
                  }`}
                >
                  <Upload size={36} className={`mb-3 ${isDragging ? "text-[#FFD000]" : "text-gray-400"}`} />
                  <p className="text-sm font-medium text-gray-700">
                    {isDragging ? "Drop files here" : "Drop files or click to upload"}
                  </p>
                  <p className="text-xs text-gray-500 mt-1">
                    ZIP/TAR (code), PDF/DOCX/MD (docs) — Type auto-detected
                  </p>
                </label>
              </div>
              
              {/* File List */}
              {files.length > 0 && (
                <div className="px-5 py-4 border-t border-gray-100">
                  <div className="flex items-center justify-between mb-3">
                    <div className="flex items-center gap-4">
                      <span className="text-sm font-medium text-gray-700">{files.length} files</span>
                      <span className="text-xs px-2 py-0.5 rounded-full bg-purple-100 text-purple-700">{codeCount} code</span>
                      <span className="text-xs px-2 py-0.5 rounded-full bg-blue-100 text-blue-700">{docCount} docs</span>
                    </div>
                    <button onClick={() => setFiles([])} className="text-xs text-gray-500 hover:text-red-500 flex items-center gap-1">
                      <Trash2 size={12} /> Clear all
                    </button>
                  </div>
                  
                  <div className="space-y-2 max-h-[240px] overflow-y-auto">
                    {files.map((f, i) => (
                      <FileItem
                        key={i}
                        file={f}
                        onRemove={() => setFiles(prev => prev.filter((_, idx) => idx !== i))}
                        onTypeChange={(newType) => setFiles(prev => prev.map((file, idx) => idx === i ? { ...file, type: newType } : file))}
                      />
                    ))}
                  </div>
                </div>
              )}
              
              {/* Action Button */}
              <div className="px-5 py-4 bg-gray-50 border-t border-gray-100">
                <button
                  onClick={handleCreate}
                  disabled={!name.trim() || codeCount === 0 || docCount === 0 || creating}
                  className="w-full py-3 bg-[#FFE600] text-[#2E2E38] font-semibold rounded-lg hover:bg-[#FFD500] transition-colors flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  {creating ? <RefreshCw size={18} className="animate-spin" /> : <Play size={18} />}
                  {creating ? "Uploading..." : "Run Gap Analysis"}
                </button>
                
                {(codeCount === 0 || docCount === 0) && files.length > 0 && (
                  <p className="text-xs text-center text-amber-600 mt-2">
                    {codeCount === 0 ? "⚠ Add at least one code file" : "⚠ Add at least one documentation file"}
                  </p>
                )}
              </div>
            </div>
          )}

          {/* Progress Section */}
          {status === "analyzing" && (
            <div className="bg-white rounded-xl border border-gray-200 shadow-sm p-8 text-center">
              <div className="w-16 h-16 mx-auto mb-4 rounded-full bg-blue-100 flex items-center justify-center">
                <RefreshCw size={28} className="text-blue-600 animate-spin" />
              </div>
              <h3 className="text-lg font-semibold text-gray-800 mb-2">
                {progress.phase === "uploading" ? "Uploading Files..." : "Analyzing Gaps..."}
              </h3>
              <p className="text-sm text-gray-500 mb-4">{progress.message}</p>
              
              <div className="max-w-xs mx-auto">
                <div className="h-2 bg-gray-200 rounded-full overflow-hidden">
                  <div 
                    className="h-full bg-gradient-to-r from-blue-500 to-blue-600 rounded-full transition-all duration-500"
                    style={{ width: `${progress.percent}%` }}
                  />
                </div>
                <p className="text-xs text-gray-400 mt-2">
                  {progress.phase === "analyzing" ? "This may take a few minutes..." : `${progress.percent}%`}
                </p>
              </div>
            </div>
          )}

          {/* Error Section */}
          {status === "failed" && (
            <div className="bg-white rounded-xl border border-red-200 shadow-sm p-6">
              <div className="flex items-start gap-4">
                <div className="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                  <AlertCircle size={20} className="text-red-600" />
                </div>
                <div className="flex-1">
                  <h3 className="text-base font-semibold text-red-800 mb-1">Analysis Failed</h3>
                  <p className="text-sm text-red-600">{error || "An unexpected error occurred"}</p>
                </div>
                <button onClick={reset} className="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200">
                  Try Again
                </button>
              </div>
            </div>
          )}

          {/* Results Section */}
          {status === "completed" && result && (
            <div className="space-y-4">
              {/* Summary Header */}
              <div className="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
                <div className="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <CheckCircle size={20} className="text-green-600" />
                    <h3 className="text-base font-semibold text-gray-800">Analysis Complete</h3>
                  </div>
                  <div className="flex items-center gap-2">
                    <button onClick={reset} className="px-3 py-1.5 text-sm font-medium text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                      New Analysis
                    </button>
                  </div>
                </div>
                
                {/* Stats Grid */}
                <div className="grid grid-cols-4 divide-x divide-gray-100">
                  <div className="p-4 text-center">
                    <p className="text-2xl font-bold text-green-600">{result.coverage_pct || 0}%</p>
                    <p className="text-xs text-gray-500 mt-1">Coverage</p>
                  </div>
                  <div className="p-4 text-center">
                    <p className="text-2xl font-bold text-red-600">{result.critical_gaps || 0}</p>
                    <p className="text-xs text-gray-500 mt-1">Critical</p>
                  </div>
                  <div className="p-4 text-center">
                    <p className="text-2xl font-bold text-orange-500">{result.major_gaps || 0}</p>
                    <p className="text-xs text-gray-500 mt-1">Major</p>
                  </div>
                  <div className="p-4 text-center">
                    <p className="text-2xl font-bold text-yellow-500">{result.minor_gaps || 0}</p>
                    <p className="text-xs text-gray-500 mt-1">Minor</p>
                  </div>
                </div>
                
                {/* Export Bar */}
                {analysisId && (
                  <div className="px-5 py-3 bg-gray-50 border-t border-gray-100 flex items-center gap-3">
                    <Download size={16} className="text-gray-500" />
                    <span className="text-sm text-gray-600">Export:</span>
                    <a href={gapAnalysisExportUrl(analysisId, "csv")} target="_blank" rel="noreferrer"
                       className="px-3 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-lg hover:bg-green-200 flex items-center gap-1">
                      <FileSpreadsheet size={12} /> CSV
                    </a>
                    <a href={gapAnalysisExportUrl(analysisId, "json")} target="_blank" rel="noreferrer"
                       className="px-3 py-1 text-xs font-medium bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 flex items-center gap-1">
                      <FileJson size={12} /> JSON
                    </a>
                    <a href={gapAnalysisExportUrl(analysisId, "html")} target="_blank" rel="noreferrer"
                       className="px-3 py-1 text-xs font-medium bg-purple-100 text-purple-700 rounded-lg hover:bg-purple-200 flex items-center gap-1">
                      <FileText size={12} /> HTML/PDF
                    </a>
                  </div>
                )}
              </div>

              {/* Gap Details */}
              {result.gaps?.length > 0 && (
                <div className="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
                  <div className="px-5 py-4 border-b border-gray-100">
                    <h3 className="text-sm font-semibold text-gray-700">Gap Details ({result.gaps.length})</h3>
                  </div>
                  <div className="divide-y divide-gray-100 max-h-[400px] overflow-y-auto">
                    {result.gaps.map((gap, i) => (
                      <div key={i} className="p-4 hover:bg-gray-50">
                        <div className="flex items-start gap-3">
                          <span className={`mt-0.5 w-2 h-2 rounded-full flex-shrink-0 ${
                            gap.severity === 'critical' ? 'bg-red-500' :
                            gap.severity === 'major' ? 'bg-orange-400' : 'bg-yellow-400'
                          }`} />
                          <div className="flex-1 min-w-0">
                            <div className="flex items-center gap-2 mb-1">
                              <span className="font-medium text-gray-800 text-sm">{gap.title}</span>
                              <span className={`text-[10px] px-1.5 py-0.5 rounded font-medium uppercase ${
                                gap.severity === 'critical' ? 'bg-red-100 text-red-700' :
                                gap.severity === 'major' ? 'bg-orange-100 text-orange-700' : 'bg-yellow-100 text-yellow-700'
                              }`}>
                                {gap.severity}
                              </span>
                            </div>
                            <p className="text-sm text-gray-600">{gap.description}</p>
                            {gap.location && <p className="text-xs text-gray-400 mt-1">📍 {gap.location}</p>}
                            {gap.recommendation && (
                              <p className="text-xs text-green-700 mt-2 bg-green-50 px-2 py-1 rounded">💡 {gap.recommendation}</p>
                            )}
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Summary */}
              {result.summary && (
                <div className="bg-blue-50 rounded-xl border border-blue-100 p-4">
                  <h3 className="text-sm font-semibold text-blue-800 mb-2">Summary</h3>
                  <p className="text-sm text-blue-700">
                    {typeof result.summary === 'string' ? result.summary : JSON.stringify(result.summary, null, 2)}
                  </p>
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
