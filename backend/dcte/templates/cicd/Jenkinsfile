pipeline {
    agent any
    tools {
        jdk 'jdk-21'
        maven 'mvn-3.9'
    }
    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build') {
            steps { sh 'mvn -B -DskipTests package' }
        }
        stage('Test') {
            steps { sh 'mvn -B test' }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        stage('Static Analysis') {
            steps { sh 'mvn -B verify -Pstatic-analysis || true' }
        }
        stage('Security Scan') {
            steps { sh 'mvn -B org.owasp:dependency-check-maven:check || true' }
        }
        stage('Container') {
            when { branch 'main' }
            steps {
                sh 'docker build -t $REGISTRY/app:$BUILD_NUMBER .'
                sh 'docker push $REGISTRY/app:$BUILD_NUMBER'
            }
        }
        stage('Deploy') {
            when { branch 'main' }
            steps {
                echo 'Deploy step — wire to your Kubernetes cluster.'
            }
        }
    }
    post {
        success { echo 'Pipeline succeeded.' }
        failure { echo 'Pipeline failed.' }
    }
}
