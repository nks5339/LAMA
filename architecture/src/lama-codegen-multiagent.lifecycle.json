{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "LAMA — Multi-Agent CodeGen Pipeline State",
    "output": "lama-codegen-multiagent.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "happy-path",
        "label": "Confirmed run",
        "focus": [
          "idle",
          "envelopes",
          "tasks",
          "executing",
          "gate"
        ],
        "note": "Two human confirmations sit between planning and any generated code."
      },
      {
        "id": "outcomes",
        "label": "Terminal outcomes",
        "focus": [
          "executing",
          "gate",
          "completed",
          "failed"
        ],
        "note": "The traceability gate is the last thing that can stop a run."
      },
      {
        "id": "restart",
        "label": "Restart surface",
        "focus": [
          "failed",
          "completed",
          "idle"
        ],
        "note": "A run restarts only from idle, failed or completed."
      }
    ],
    "viewBox": [
      1080,
      600
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Pipeline state"
    },
    {
      "id": "terminal",
      "label": "Terminal outcomes"
    }
  ],
  "states": [
    {
      "id": "idle",
      "type": "start",
      "label": "Idle",
      "sublabel": "no run in flight",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "entry"
    },
    {
      "id": "envelopes",
      "type": "waiting",
      "label": "Envelopes",
      "sublabel": "pending → confirmed",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "human gate"
    },
    {
      "id": "tasks",
      "type": "waiting",
      "label": "Tasks",
      "sublabel": "pending → confirmed",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "human gate"
    },
    {
      "id": "executing",
      "type": "active",
      "label": "Executing",
      "sublabel": "coder waves",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "BE + FE"
    },
    {
      "id": "gate",
      "type": "decision",
      "label": "Traceability Gate",
      "sublabel": "final check",
      "lane": "main",
      "col": 4,
      "step": "05"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Failed",
      "sublabel": "run stopped",
      "lane": "terminal",
      "col": 1,
      "yOffset": -60
    },
    {
      "id": "completed",
      "type": "success",
      "label": "Completed",
      "sublabel": "files finalized",
      "lane": "terminal",
      "col": 2,
      "yOffset": -60
    }
  ],
  "transitions": [
    {
      "id": "start-run",
      "from": "idle",
      "to": "envelopes",
      "label": "start",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "confirm-envelopes",
      "from": "envelopes",
      "to": "tasks",
      "label": "confirm envelopes",
      "variant": "emphasis",
      "labelDy": -25
    },
    {
      "id": "confirm-tasks",
      "from": "tasks",
      "to": "executing",
      "label": "confirm tasks",
      "variant": "emphasis",
      "labelDy": -25
    },
    {
      "id": "waves-done",
      "from": "executing",
      "to": "gate",
      "label": "waves complete",
      "variant": "emphasis",
      "labelDy": -25
    },
    {
      "id": "gate-pass",
      "from": "gate",
      "to": "completed",
      "label": "passes",
      "variant": "emphasis",
      "labelDy": 24
    },
    {
      "id": "exec-error",
      "from": "executing",
      "to": "failed",
      "label": "agent error",
      "variant": "security",
      "labelDy": 24
    },
    {
      "id": "restart",
      "from": "failed",
      "to": "idle",
      "label": "rerun",
      "variant": "dashed",
      "route": "bottom-channel"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Two human gates",
      "items": [
        "Envelopes confirmed before planning",
        "Tasks confirmed before any file"
      ]
    },
    {
      "dot": "cyan",
      "title": "Inside Executing",
      "items": [
        "Work runs in backend/frontend waves",
        "A deterministic router overrides the planner"
      ]
    },
    {
      "dot": "rose",
      "title": "Stop and restart",
      "items": [
        "The traceability gate is the last stop",
        "Restart only from idle, failed, completed"
      ]
    }
  ]
}
