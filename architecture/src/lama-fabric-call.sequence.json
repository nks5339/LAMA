  "cards": [
    {
      "dot": "emerald",
      "title": "One door in",
      "items": [
        "Stage routes never call an HTTP provider directly",
        "fabric_call() only mints a trace id and delegates",
        "All routing decisions live in _fabric_call_impl"
      ]
    },
    {
      "dot": "rose",
      "title": "Health gate",
      "items": [
        "Every call probes for a healthy provider first",
        "Probe order is Factory, then Azure, Anthropic, OpenAI, Gemini, Groq, Ollama",
        "With nothing healthy the call raises instead of guessing"
      ]
    },
    {
      "dot": "orange",
      "title": "Two transports, one at a time",
      "items": [
        "Factory and Console routing are alternatives, not a chain",
        "The API-versus-CLI split happens inside the orchestrator",
        "The trace is written even when the call fails"
      ]
    }
