  "edges": [
    {
      "id": "discovery-datamodel",
      "from": "discovery",
      "to": "datamodel",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "datamodel-architecture",
      "from": "datamodel",
      "to": "architecture",
      "role": "main"
    },
    {
      "id": "architecture-codegen",
      "from": "architecture",
      "to": "codegen",
      "role": "main"
    },
    {
      "id": "codegen-living",
      "from": "codegen",
      "to": "living",
      "role": "main"
    },
    {
      "id": "discovery-freeze",
      "from": "discovery",
      "to": "freeze",
      "label": "typed FREEZE",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "freeze-stagectx",
      "from": "freeze",
      "to": "stagectx",
      "label": "save_stage_context()",
      "role": "branch"
    },
    {
      "id": "stagectx-datamodel",
      "from": "stagectx",
      "to": "datamodel",
      "label": "marks next available",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "architecture-skipped",
      "from": "architecture",
      "to": "skipped",
      "label": "skip",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "skipped-codegen",
      "from": "skipped",
      "to": "codegen",
      "label": "minimal StageContext",
      "variant": "dashed",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "One ordered path",
      "items": [
        "Stages run in strict order",
        "Each route calls require_stage_context",
        "The same handoff repeats 4 times"
      ]
    },
    {
      "dot": "cyan",
      "title": "What a freeze writes",
      "items": [
        "A StageContext per project and stage",
        "Its version counter increments",
        "The next stage becomes available"
      ]
    },
    {
      "dot": "rose",
      "title": "Stop conditions",
      "items": [
        "Unfrozen upstream returns HTTP 400",
        "Only stages 2, 3 and 5 may be skipped",
        "Discovery and CodeGen never skip"
      ]
    }
  ]
}
