{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "LAMA — Freeze-Gated Migration Pipeline",
    "output": "lama-pipeline.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "happy-path",
        "label": "Sequential stages",
        "focus": [
          "discovery",
          "datamodel",
          "architecture",
          "codegen",
          "living"
        ],
        "note": "The five stages always run in order, each unlocked by the one before it."
      },
      {
        "id": "handoff",
        "label": "How a stage unlocks the next",
        "focus": [
          "discovery",
          "freeze",
          "stagectx",
          "datamodel"
        ],
        "note": "Freezing writes a StageContext document and promotes the following stage."
      },
      {
        "id": "exceptions",
        "label": "Skipping a stage",
        "focus": [
          "architecture",
          "skipped",
          "codegen"
        ],
        "note": "Skipping writes a minimal StageContext so the downstream gate still passes."
      }
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "backend": {
          "label": "Generation stage"
        },
        "database": {
          "label": "Data artifact"
        },
        "cloud": {
          "label": "Design stage"
        },
        "external": {
          "label": "Runtime stage"
        },
        "security": {
          "label": "Human gate"
        },
        "messagebus": {
          "label": "Bypass"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "stages",
      "label": "Pipeline Stages"
    },
    {
      "id": "handoff",
      "label": "Stage Handoff"
    }
  ],
  "phases": [
    {
      "id": "understand",
      "label": "Understand",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "design",
      "label": "Design",
      "fromCol": 2,
      "toCol": 3,
