  "cards": [
    {
      "dot": "cyan",
      "title": "Edge",
      "items": [
        "nginx :8382 is the only exposed port",
        "/api/ proxies to uvicorn on :8001",
        "Unmatched paths fall back to index.html",
        "supervisord runs mongod, uvicorn and nginx"
      ]
    },
    {
      "dot": "emerald",
      "title": "Application and state",
      "items": [
        "21 router mounts from 20 route modules",
        "MongoDB is LAMA's own system of record",
        "Qdrant is off unless QDRANT_URL or QDRANT_PATH is set",
        "Callers degrade to TOON-only when it is absent"
      ]
    },
    {
      "dot": "violet",
      "title": "Model routing",
      "items": [
        "Presets: OpenRouter, Anthropic, OpenAI, Azure, Gemini, Groq, Ollama, custom",
        "fabric_call() only traces; routing lives in _fabric_call_impl",
        "Factory is reached over HTTP or the local droid CLI",
        "Every call is probed for a healthy provider first"
      ]
    }
  ]
