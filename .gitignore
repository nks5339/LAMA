# ---------------------------------------------------------------------------
# Secrets / environment
# ---------------------------------------------------------------------------
# Root `.env` IS committed — its header documents it as non-secret compose
# defaults only. `backend/.env` holds real OPENROUTER / QDRANT keys.
backend/.env
frontend/.env.local
frontend/.env.*.local
*.pem
!wheels/**/*.pem

# iter-13.128 — Corporate CA bundle for droid CLI (org-specific, not for git).
# See docker-compose.yml LAMA_CORP_CA_HOST env-var for override.
certs/
corp-ca.pem

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.venv/
venv/
backend/venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---------------------------------------------------------------------------
# Node / frontend
# NOTE: ./wheels IS tracked — docker-compose bind-mounts it to seed /wheels.
# ---------------------------------------------------------------------------
node_modules/
frontend/build/
.eslintcache
yarn-error.log
npm-debug.log*

# ---------------------------------------------------------------------------
# Caches / scratch
# ---------------------------------------------------------------------------
hf_cache/
.lama-git-cache/
# Agent tooling. The `skills` CLI added `.claude/` here during install (it
# arrived in the Secrets block above with an absolute local path as its only
# comment — see architecture/report.md Part E). The vendored archify skill is
# 8.4 MB and is deliberately NOT committed: a fresh clone re-runs
#   npx skills add tt-a1i/archify -a claude-code -s '*' --copy -y
# before regenerating a diagram. The delivered HTML in architecture/diagrams/
# is self-contained and needs no tooling to read.
.claude/
.claude/worktrees/
# Embedded (offline) Qdrant store — see QDRANT_PATH in backend/.env
.qdrant_local/
backend/.qdrant_local/

# ---------------------------------------------------------------------------
# Runtime output (iter-22)
# ---------------------------------------------------------------------------
# Droid slim-mode KB. `LAMA_FACTORY_CLI_SLIM=1` strips the fat KB/TOON blocks
# out of every droid prompt and materialises them here on the agent's cwd at
# Build KB time (see docker-compose.yml). When that cwd is the repo root —
# which it is for a local `uvicorn server:app` — the whole KB lands in the
# working tree.
/.lama/

# Direct Transform job output. `TransformationEngine._prep_output_root`
# creates these five directories under whatever `output_root` the job names,
# and `output_root` is resolved against LAMA_DCTE_WORKSPACE, which defaults
# to $HOME. Pointing a job at the repo is an easy mistake to make and lands
# a whole migrated codebase in `git status`.
#
# Root-anchored on purpose: `backend/dcte/samples/` IS tracked (the Helidon
# and Oracle fixtures the tests run against), and bare names would swallow it.
/converted-source/
/database-scripts/
/documentation/
/cicd/
/out/
/output/
# `engine.rollback()` moves output_root aside as `<name>.rollback.<ts>`.
*.rollback.[0-9]*

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.DS_Store
.idea/
*.swp

# ---------------------------------------------------------------------------
# Project backups (skip-pattern parity with kb/parsers.py)
# ---------------------------------------------------------------------------
*.bak
*.save
*_bkp
*_old
*_backup
