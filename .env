# Compose environment overrides. Committed with only non-secret defaults.
#
# LAMA_IMAGE — pin the image compose spins up. Defaults to the public
# `mishramesh/lama:latest`. We override to `lama:local`, which is built
# from Dockerfile.local and adds `git` + `dulwich` on top of the public
# image (needed by the /api/kb/{pid}/clone-git endpoint until the public
# image is refreshed with the iter-13.90 base Dockerfile).
LAMA_IMAGE=lama:local
# lama:local is a local-only tag (see Dockerfile.local). Skip pulling
# from Docker Hub — otherwise compose fails with "pull access denied".
LAMA_PULL_POLICY=never
LAMA_FACTORY_CLI_DUMP_PROMPT=1

# iter-14.10 — Token-spend guardrails (see docker-compose.yml for the
# full explanation). Both default to 1 in compose; setting them here
# makes the intent explicit and grep-able.
LAMA_FACTORY_CLI_SLIM=1
# LAMA_DISABLE_OPENROUTER_FALLBACK removed 2026-09: no code has read it
# since iter-14.31 deleted the OpenRouter fallback outright.
LAMA_FACTORY_MODE=cli
LAMA_JWT_SECRET=change-me-to-any-random-string-32chars-long
LAMA_CONFIDENCE_ENGINE=langgraph
LAMA_JWT_SECRET=change-me-to-any-random-string-32chars-long
LAMA_CONFIDENCE_ENGINE=langgraph
